# =============================================================================
# Codgar AI – environment template.  Copy to `.env` and fill in real values:
#     cp .env.example .env
# NEVER commit a real key. `.env` is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) AI providers (at least one is required for real answers)
#    Without any of these the /api/chat endpoint answers 501 NO_PROVIDER_CONFIGURED
#    instead of returning a canned/invented reply.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=

ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=

# -----------------------------------------------------------------------------
# 2) Optional local routers (9Router / OmniRoute / VansRouter).
#    These binaries are NOT part of this repository. If they are installed and
#    running, the server will use them; otherwise it simply skips them (no crash).
# -----------------------------------------------------------------------------
NINEROUTER_API_KEY=
OMNIROUTE_API_KEY=
VANSROUTER_API_KEY=
# Override the default ports if needed (20128 / 20130 / 20132)
NINEROUTER_PORT=
OMNIROUTE_PORT=
VANSROUTER_PORT=
# Only set this to 1 if you really want a missing tool to be downloaded at runtime.
ALLOW_AUTO_INSTALL=

# -----------------------------------------------------------------------------
# 3) Server / networking
# -----------------------------------------------------------------------------
PORT=3000
# 127.0.0.1 keeps the server local-only. 0.0.0.0 exposes it to the network.
BIND_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 4) Security
# -----------------------------------------------------------------------------
# Strongly recommended whenever BIND_HOST is not 127.0.0.1.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When set, requests that are not same-origin/loopback must send it in the
# `X-Admin-Token` header to reach code-execution endpoints.
ADMIN_TOKEN=
# Set to 1 to require X-Admin-Token even for localhost (breaks the local UI).
CODGAR_STRICT_EXEC_TOKEN=
# Extra allowed browser origins (comma separated), e.g. https://my-ui.example.com
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# 5) Modes & behaviour
# -----------------------------------------------------------------------------
# 1 = allow the canned/demo replies (clearly marked with demo:true). Use only for demos.
CODGAR_DEMO_MODE=
# PIN for the local virtual API keys (change it; never leave the default in production).
CODGAR_PIN=
# Language of the interface fallbacks: fa | en
CODGAR_LANG=fa

# -----------------------------------------------------------------------------
# 6) Optional connectors
# -----------------------------------------------------------------------------
# Gmail connector (use a Google "App Password", not your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
