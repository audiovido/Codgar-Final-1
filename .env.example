# =============================================================================
# Codgar AI – environment template.  Copy to `.env` and fill in real values:
#     cp .env.example .env
# NEVER commit a real key. `.env` is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) موتور اصلی = سه روتر پس‌زمینه (9Router → OmniRoute → VansRouter)
#    MAIN ENGINE = the three local routers. No cloud API key is required.
#    اگر باینری‌ها نصب باشند، سرور خودش هنگام بالا آمدن آن‌ها را اجرا می‌کند.
#    اگر روی پورت/ماشین دیگری اجرا می‌شوند، فقط آدرسشان را اینجا بدهید.
# -----------------------------------------------------------------------------
# آدرس کامل (در صورت تنظیم، پورت نادیده گرفته می‌شود)
NINEROUTER_URL=
OMNIROUTE_URL=
VANSROUTER_URL=
# یا فقط پورت (پیش‌فرض‌ها: 20128 / 20130 / 20132)
NINEROUTER_PORT=
OMNIROUTE_PORT=
VANSROUTER_PORT=
# هاست مشترک روترها (پیش‌فرض 127.0.0.1)
CODGAR_ROUTER_HOST=
# کلید روترها (اختیاری؛ فقط اگر خود روتر احراز هویت می‌خواهد)
NINEROUTER_API_KEY=
OMNIROUTE_API_KEY=
VANSROUTER_API_KEY=
# مدل پیش‌فرضی که به روترها فرستاده می‌شود
CODGAR_ROUTER_MODEL=codgar-code
# 0 = سرور روترها را خودش استارت نکند (وقتی خودتان جداگانه اجرایشان می‌کنید)
CODGAR_AUTOSTART_ROUTERS=
# فقط برای تست محلی: یک OmniRoute شبیه‌سازی‌شده بالا می‌آورد (پاسخ‌هایش
# با هدر X-Codgar-Simulated علامت می‌خورند و به‌عنوان پاسخ واقعی پذیرفته نمی‌شوند)
CODGAR_MOCK_OMNIROUTE=

# -----------------------------------------------------------------------------
# 2) فال‌بک ابری — کاملاً اختیاری (OPTIONAL cloud fallback)
#    فقط وقتی استفاده می‌شود که هیچ‌کدام از سه روتر در دسترس نباشند.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only set this to 1 if you really want a missing tool to be downloaded at runtime.
ALLOW_AUTO_INSTALL=

# -----------------------------------------------------------------------------
# 3) Server / networking
# -----------------------------------------------------------------------------
PORT=3000
# 127.0.0.1 keeps the server local-only. 0.0.0.0 exposes it to the network.
BIND_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 4) Security
# -----------------------------------------------------------------------------
# Strongly recommended whenever BIND_HOST is not 127.0.0.1.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When set, requests that are not same-origin/loopback must send it in the
# `X-Admin-Token` header to reach code-execution endpoints.
ADMIN_TOKEN=
# Set to 1 to require X-Admin-Token even for localhost (breaks the local UI).
CODGAR_STRICT_EXEC_TOKEN=
# Extra allowed browser origins (comma separated), e.g. https://my-ui.example.com
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# 5) Modes & behaviour
# -----------------------------------------------------------------------------
# 1 = allow the canned/demo replies (clearly marked with demo:true). Use only for demos.
CODGAR_DEMO_MODE=
# PIN for the local virtual API keys (change it; never leave the default in production).
CODGAR_PIN=
# Language of the interface fallbacks: fa | en
CODGAR_LANG=fa

# -----------------------------------------------------------------------------
# 6) Optional connectors
# -----------------------------------------------------------------------------
# Gmail connector (use a Google "App Password", not your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
